{
  "name": "@codihaus/fetchpipe",
  "version": "0.1.0",
  "description": "Composable, zero-dependency API client SDK foundation",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown",
    "test": "vitest run",
    "test:types": "vitest run --typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
